// Palimpsest — палитра «Гуашь на тёмной бумаге».
// Правится руками; это часть мира, а не конфиг.
//
// Принципы:
//  * у каждого цвета имя из мира, а не «teal-400»;
//  * paper — тёплый почти-чёрный фон листа, единственный чистый чёрный — void;
//  * gold — только для ритуального: колода, тяга карты, курсор-пульс;
//  * hex — truecolor, x256 — курированный фолбэк для терминалов без 24-bit
//    (не автоподбор: коллизии разведены руками — см. gold и hills).

Palette(
    id: "gouache_on_dark_paper",
    title: "Гуашь на тёмной бумаге",
    colors: [
        // --- лист ---
        Color(id: "paper",          ru: "бумага",           hex: "#16130e", x256: 233), // фон; тёплый картон ночью
        Color(id: "void",           ru: "пустота",          hex: "#0a0908", x256: 232), // дыра в бумаге; чернее фона
        Color(id: "void_edge_far",  ru: "край истлевший",   hex: "#2a2620", x256: 235), // дизеринг ░ на границе пустоты
        Color(id: "void_edge_near", ru: "край живой",       hex: "#38332a", x256: 236), // дизеринг ▒ ближе к тайлам
        Color(id: "frame",          ru: "рамка",            hex: "#2c2820", x256: 235), // линии интерфейса

        // --- чернила ---
        Color(id: "ink",            ru: "чернила",          hex: "#d8d0bf", x256: 187), // основной текст, хроника
        Color(id: "ink_faded",      ru: "чернила выцветшие",hex: "#a89f8c", x256: 144), // вторичный текст, тропы
        Color(id: "ink_muted",      ru: "чернила блёклые",  hex: "#6f685a", x256: 241), // подписи, служебное

        // --- краски мира ---
        Color(id: "water",          ru: "вода",             hex: "#4fa89a", x256: 72),
        Color(id: "water_deep",     ru: "вода глубокая",    hex: "#3d8a7e", x256: 66),  // вторая фаза мерцания
        Color(id: "ochre",          ru: "охра полей",       hex: "#c9a24b", x256: 179),
        Color(id: "moss",           ru: "мох лесов",        hex: "#7a8f4e", x256: 101),
        Color(id: "meadow",         ru: "луг",              hex: "#6b7a4e", x256: 65),
        Color(id: "hills",          ru: "холмы",            hex: "#8d8371", x256: 102), // 101 занят мхом — разведено
        Color(id: "brick",          ru: "кирпич поселений", hex: "#c0603f", x256: 131),

        // --- церемониальное ---
        Color(id: "gold",           ru: "золото ритуала",   hex: "#e0b458", x256: 178), // 179 занят охрой — разведено
    ],
)
